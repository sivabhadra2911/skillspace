# Frontend (Vite). Set this to your public API URL for GitHub Pages.
VITE_API_URL=http://localhost:4000

# Node API. Create the skillspace database in PostgreSQL first.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/skillspace
DATABASE_SSL=false
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,https://sivabhadra2911.github.io
PORT=4000
